/**
 * @file      version/version.hpp
 * @brief     The version record: its values, its layout and the Record struct.
 *
 * Element:   Nexus-Physical-01-04 (bootloader)
 * Decisions: SW-08
 *
 * Generated by CMake from version/version.hpp.in. Do not edit, do not commit.
 *
 * The record is 64 bytes at a fixed place in the image, readable with `strings` or at 0x08000200
 * in a hex or SREC dump. Its layout is a contract with the application and the image tool (SW-08).
 */

#ifndef NEXUS_VERSION_VERSION_HPP
#define NEXUS_VERSION_VERSION_HPP

#include <cstddef>
#include <cstdint>

namespace nexus::fbl::version {

/* Values from cmake/project-settings.cmake. */
inline constexpr char kSoftwareType[]    = "@NEXUS_SW_TYPE@";
inline constexpr char kPlatformName[]    = "@NEXUS_PLATFORM_NAME@";
inline constexpr char kPlatformVersion[] = "@NEXUS_PLATFORM_VERSION@";
inline constexpr char kSoftwareVersion[] = "@NEXUS_SW_VERSION_STRING@";  /* AA-BB-CC */
inline constexpr char kRecordString[]    = "@NEXUS_RECORD_STRING@";

inline constexpr std::uint8_t kMajor = @NEXUS_VERSION_MAJOR@;
inline constexpr std::uint8_t kMinor = @NEXUS_VERSION_MINOR@;
inline constexpr std::uint8_t kPatch = @NEXUS_VERSION_PATCH@;

/* Layout. The widths are written once, in cmake/version.cmake, which checks the settings against them. */
inline constexpr std::size_t kRecordSize      = @NEXUS_RECORD_SIZE@;
inline constexpr std::size_t kTypeSize        = @NEXUS_RECORD_TYPE_SIZE@;
inline constexpr std::size_t kPlatformSize    = @NEXUS_RECORD_PLATFORM_SIZE@;
inline constexpr std::size_t kPlatformVerSize = @NEXUS_RECORD_PLATFORM_VER_SIZE@;
inline constexpr std::size_t kSwVersionSize   = @NEXUS_RECORD_SW_VERSION_SIZE@;
inline constexpr std::size_t kReservedSize    = @NEXUS_RECORD_RESERVED_SIZE@;
inline constexpr std::uint8_t kReservedFill   = 0xFF;  /* erased flash: a later field can be programmed in */

/* "FBL_Nexus_v1_00-01-00" followed by a NUL, then the reserved bytes. */
struct Record {
    char type[kTypeSize];
    char separator0;
    char platform[kPlatformSize];
    char separator1;
    char platformVersion[kPlatformVerSize];
    char separator2;
    char swVersion[kSwVersionSize];
    char terminator;
    std::uint8_t reserved[kReservedSize];
};

static_assert(sizeof(Record) == kRecordSize, "the version record has its set size");
static_assert(sizeof(kSoftwareType) == kTypeSize + 1, "software type is 3 characters");
static_assert(sizeof(kPlatformName) == kPlatformSize + 1, "platform name is 5 characters");
static_assert(sizeof(kPlatformVersion) == kPlatformVerSize + 1, "platform version is 2 characters");
static_assert(sizeof(kSoftwareVersion) == kSwVersionSize + 1, "software version is AA-BB-CC");
static_assert(sizeof(kRecordString) == offsetof(Record, terminator) + 1U, "the record string is the text of the record");

/* Defined in version.cpp, in the section .version, which fbl.ld places at 0x08000200. */
extern const Record kRecord;

}  /* namespace nexus::fbl::version */

#endif  /* NEXUS_VERSION_VERSION_HPP */
