{
    "cmake.useCMakePresets": "always",
    "cmake.options.statusBarVisibility": "hidden",
    "cmake.options.advanced": {
        "configurePreset": { "statusBarVisibility": "visible" },
        "buildPreset": { "statusBarVisibility": "visible" },
        "buildTarget": { "statusBarVisibility": "visible" },
        "build": { "statusBarVisibility": "visible" }
    },
    "cortex-debug.variableUseNaturalFormat": false,
    "python.autoComplete.extraPaths": [
        "${workspaceFolder}/sources/poky/bitbake/lib",
        "${workspaceFolder}/sources/poky/meta/lib"
    ],
    "python.analysis.extraPaths": [
        "${workspaceFolder}/sources/poky/bitbake/lib",
        "${workspaceFolder}/sources/poky/meta/lib"
    ],
    "files.associations": {
        "*.conf": "bitbake",
        "*.inc": "bitbake"
    }
}
